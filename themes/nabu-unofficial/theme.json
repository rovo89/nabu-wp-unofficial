{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "940px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "nabu-blue",
					"name": "NABU Blau",
					"color": "#0068b2"
				},
				{
					"slug": "nabu-darkblue",
					"name": "NABU Dunkelblau",
					"color": "#003666"
				},
				{
					"slug": "nabu-lightblue",
					"name": "NABU Hellblau",
					"color": "#dbe5f5"
				},
				{
					"slug": "nabu-orange",
					"name": "NABU Orange",
					"color": "#f07c00"
				},
				{
					"slug": "nabu-darkorange",
					"name": "NABU Dunkelorange",
					"color": "#b85f00"
				},
				{
					"slug": "nabu-sand",
					"name": "NABU Sand",
					"color": "#e3e2d4"
				},
				{
					"slug": "nabu-greygreen",
					"name": "NABU Graugrün",
					"color": "#85836b"
				},
				{
					"slug": "nabu-green",
					"name": "NABU Grün",
					"color": "#83b545"
				},
				{
					"slug": "nabu-darkgreen",
					"name": "NABU Dunkelgrün",
					"color": "#3b6312"
				},
				{
					"slug": "nabu-lightgreen",
					"name": "NABU Hellgrün",
					"color": "#dee9c8"
				},
				{
					"slug": "nabu-red",
					"name": "NABU Rot",
					"color": "#c92c37"
				},
				{
					"slug": "nabu-darkred",
					"name": "NABU Dunkelrot",
					"color": "#8b1319"
				},
				{
					"slug": "nabu-yellow",
					"name": "NABU Gelb",
					"color": "#ffcc00"
				},
				{
					"slug": "nabu-text",
					"name": "Text",
					"color": "#373a3c"
				},
				{
					"slug": "nabu-text-muted",
					"name": "Text gedämpft",
					"color": "#707070"
				},
				{
					"slug": "white",
					"name": "Weiß",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"slug": "scrim",
					"name": "Bild-Abdunklung (für weißen Text)",
					"gradient": "linear-gradient(0deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.35) 45%, rgba(0,0,0,0) 100%)"
				},
				{
					"slug": "scrim-left",
					"name": "Bild-Abdunklung von links",
					"gradient": "linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.35) 50%, rgba(0,0,0,0) 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Source Sans 3",
					"fontFamily": "\"Source Sans 3\", \"Source Sans Pro\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, Helvetica, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Klein (Bildnachweis)",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Meta / Fußzeile",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Fließtext",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "lead",
					"name": "Intro",
					"size": "1.09375rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.09375rem"
					}
				},
				{
					"slug": "large",
					"name": "H2",
					"size": "1.53125rem",
					"fluid": {
						"min": "1.3125rem",
						"max": "1.53125rem"
					}
				},
				{
					"slug": "x-large",
					"name": "H1 / Seitentitel",
					"size": "1.75rem",
					"fluid": {
						"min": "1.4375rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Groß (Titelbild)",
					"size": "2.1875rem",
					"fluid": {
						"min": "1.6875rem",
						"max": "2.1875rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"rem",
				"px",
				"%",
				"vw",
				"vh"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "2rem"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "3rem"
				},
				{
					"slug": "70",
					"name": "2XL",
					"size": "4rem"
				},
				{
					"slug": "80",
					"name": "3XL",
					"size": "6rem"
				}
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "Leicht",
					"shadow": "0 1px 2px rgba(0,0,0,0.08)"
				},
				{
					"slug": "md",
					"name": "Karte",
					"shadow": "0 2px 8px rgba(0,0,0,0.12)"
				}
			]
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"customFontSize": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--nabu-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.4"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--nabu-blue)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--nabu-darkblue)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.1"
				},
				"color": {
					"text": "var(--wp--preset--color--nabu-blue)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				},
				"spacing": {
					"margin": {
						"bottom": "0.625rem"
					}
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.3125rem"
				},
				"color": {
					"text": "var(--wp--preset--color--nabu-greygreen)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "0.9375rem"
				},
				"color": {
					"text": "var(--wp--preset--color--nabu-greygreen)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "1.125rem",
					"fontWeight": "400",
					"textTransform": "uppercase"
				},
				"color": {
					"text": "var(--wp--preset--color--nabu-greygreen)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--nabu-blue)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "0.9375rem",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				"border": {
					"radius": "7px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--nabu-darkblue)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--nabu-darkblue)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"lineHeight": "1.4"
				},
				"color": {
					"text": "var(--wp--preset--color--nabu-greygreen)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "600",
					"fontSize": "1.25rem",
					"lineHeight": "1.2"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--nabu-orange)",
						"width": "4px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lead)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--nabu-sand)"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lead)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Kopfbereich",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Fußbereich",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "Seitenspalte",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-full",
			"title": "Seite ohne Titel (volle Breite)",
			"postTypes": [
				"page"
			]
		}
	]
}
