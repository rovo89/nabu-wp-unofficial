# Copy to .env; Docker Compose and the scripts read it.
#
# The instance the scripts use by default; NABU_INSTANCE=clean picks the
# other one:
#   NABU_INSTANCE=clean ./scripts/setup.sh
#
# The project name decides which Docker volumes hold the data.
COMPOSE_PROJECT_NAME=nabu-staging
NABU_PORT=8090
# 127.0.0.1 keeps an instance on this machine, 0.0.0.0 opens it to the LAN or
# tailnet. Keep staging, a copy of production, on 127.0.0.1.
NABU_BIND=127.0.0.1

# The clean instance: project nabu-clean, demo content, admin/admin.
NABU_CLEAN_PORT=8091
NABU_CLEAN_BIND=0.0.0.0

# Production, for scripts/staging-refresh.sh and scripts/deploy.sh. No
# secrets here: SSH logs in with a key, and the database credentials stay in
# wp-config.php on the server.
#
# NABU_PROD_SSH     host alias from ~/.ssh/config, or user@host
# NABU_PROD_PATH    document root, the directory holding wp-config.php
# NABU_PROD_URL     site address
# NABU_PROD_REPO    where deploy.sh unpacks the repository, beside the
#                   document root so none of it is web-readable
# NABU_PROD_WP      wp-cli on the server, if it is not on the PATH there
NABU_PROD_SSH=nabu-prod
NABU_PROD_PATH=/example.org/httpdocs
NABU_PROD_URL=https://example.org
NABU_PROD_REPO=/nabu-unofficial
# NABU_PROD_WP=/path/to/wp
